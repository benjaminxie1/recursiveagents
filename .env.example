# Crusoe Managed Inference (required). Keys can contain `$`; in a shell, wrap in single quotes.
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# Optional per-model requests/minute before a limit header is seen (30 no card, 600 with one).
# CRUSOE_RPM=30

# You.com web search for cited research (OEM manuals, fault codes, grid standards)
YDC_API_KEY=

# ntfy.sh topic for real phone pushes from page_human on live runs (unset = no pushes).
# Topics are public: anyone who knows the name can read them, so use a long random name.
NTFY_TOPIC=

# Decision gate backend: local|jev|openai. local uses the gate role on Crusoe (no extra key);
# jev and openai need their key below and fall back to local when it is missing.
DECISION_BACKEND=local
JEV_API_KEY=
OPENAI_API_KEY=
