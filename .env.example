# Crusoe Managed Inference (required). Keys can contain `$`; in a shell, wrap in single quotes.
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1

# You.com web search for cited research (OEM manuals, fault codes, grid standards)
YDC_API_KEY=

# Alike MCP shared memory: OAuth in the browser, no key. Create an account at alike.network first.
ALIKE_MCP_URL=https://alike.network/api-general/mcp

# Decision gate: set one or both. DECISION_BACKEND=jev|openai
DECISION_BACKEND=jev
JEV_API_KEY=
OPENAI_API_KEY=
